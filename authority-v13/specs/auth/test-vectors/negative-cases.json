{
  "schemaVersion": 1,
  "specificationVersion": "13.0.0",
  "cases": [
    {
      "id": "service-expired",
      "base": "service-assertion.json",
      "mutation": {
        "exp": 1783814399
      },
      "now": 1783814405,
      "expectedError": "SERVICE_ASSERTION_EXPIRED"
    },
    {
      "id": "service-wrong-audience",
      "base": "service-assertion.json",
      "mutation": {
        "aud": "control-api"
      },
      "now": 1783814405,
      "expectedError": "SERVICE_ASSERTION_AUDIENCE_MISMATCH"
    },
    {
      "id": "service-wrong-body",
      "base": "service-assertion.json",
      "requestBody": "{\"sessionToken\":\"different\"}",
      "now": 1783814405,
      "expectedError": "SERVICE_ASSERTION_REQUEST_MISMATCH"
    },
    {
      "id": "service-replay",
      "base": "service-assertion.json",
      "attempts": 2,
      "now": 1783814405,
      "expectedErrorOnAttempt": {
        "2": "SERVICE_ASSERTION_REPLAYED"
      }
    },
    {
      "id": "service-unknown-key",
      "base": "service-assertion.json",
      "kid": "ffffffffffffffff",
      "now": 1783814405,
      "expectedError": "SERVICE_ASSERTION_INVALID"
    },
    {
      "id": "actor-expired",
      "base": "actor-assertion.json",
      "mutation": {
        "exp": 1783814399
      },
      "now": 1783814405,
      "expectedError": "ACTOR_ASSERTION_EXPIRED"
    },
    {
      "id": "actor-wrong-audience",
      "base": "actor-assertion.json",
      "mutation": {
        "aud": "identity-api"
      },
      "now": 1783814405,
      "expectedError": "ACTOR_ASSERTION_AUDIENCE_MISMATCH"
    },
    {
      "id": "actor-wrong-path",
      "base": "actor-assertion.json",
      "requestPath": "/v1/internal/commands/add-claim",
      "now": 1783814405,
      "expectedError": "ACTOR_ASSERTION_REQUEST_MISMATCH"
    },
    {
      "id": "actor-replay",
      "base": "actor-assertion.json",
      "attempts": 2,
      "now": 1783814405,
      "expectedErrorOnAttempt": {
        "2": "ACTOR_ASSERTION_REPLAYED"
      }
    },
    {
      "id": "actor-unknown-key",
      "base": "actor-assertion.json",
      "kid": "ffffffffffffffff",
      "now": 1783814405,
      "expectedError": "ACTOR_ASSERTION_INVALID"
    },
    {
      "id": "service-wrong-signature",
      "base": "service-assertion.json",
      "mutationMode": "flip-signature-bit",
      "now": 1783814405,
      "expectedError": "SERVICE_ASSERTION_INVALID"
    },
    {
      "id": "actor-noncanonical-payload",
      "base": "actor-assertion.json",
      "mutationMode": "valid-signature-over-noncanonical-json",
      "now": 1783814405,
      "expectedError": "ACTOR_ASSERTION_INVALID"
    }
  ]
}
