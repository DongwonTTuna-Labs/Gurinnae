{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "citations",
    "unknowns",
    "abstention_reasons"
  ],
  "properties": {
    "status": {
      "enum": [
        "COMPLETED",
        "ABSTAINED",
        "POLICY_BLOCKED",
        "BUDGET_BLOCKED"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 6000
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "locator",
          "supports"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "format": "uuid"
          },
          "locator": {
            "type": "string"
          },
          "supports": {
            "type": "string"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "abstention_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_type",
          "reason"
        ],
        "properties": {
          "action_type": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_type",
          "text",
          "evidence_ids",
          "response_ids",
          "limitations"
        ],
        "properties": {
          "claim_type": {
            "enum": [
              "FACT",
              "CALCULATION",
              "INFERENCE",
              "LIMITATION",
              "OFFICIAL_OUTCOME"
            ]
          },
          "text": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "response_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
