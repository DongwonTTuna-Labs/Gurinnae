{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gurine.invalid/common.schema.json",
  "title": "Gurine common definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "amount_minor"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "KRW"
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 0,
          "description": "통화 최소 단위. KRW는 원."
        },
        "vat_basis": {
          "enum": [
            "INCLUDED",
            "EXCLUDED",
            "EXEMPT",
            "MIXED",
            "UNKNOWN"
          ]
        }
      }
    },
    "actor_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id"
      ],
      "properties": {
        "actor_type": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AGENT"
          ]
        },
        "actor_id": {
          "$ref": "#/$defs/id"
        },
        "display_role": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "JSON_PATH",
            "XPATH",
            "CSS",
            "PDF_PAGE",
            "PDF_REGION",
            "SPREADSHEET_CELL",
            "TEXT_RANGE",
            "API_FIELD"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bounding_box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "field_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_document_id",
        "locator",
        "raw_value_hash",
        "parser_version",
        "transform_version"
      ],
      "properties": {
        "source_document_id": {
          "$ref": "#/$defs/id"
        },
        "locator": {
          "$ref": "#/$defs/source_locator"
        },
        "raw_value_hash": {
          "$ref": "#/$defs/sha256"
        },
        "raw_value_preview": {
          "type": "string",
          "maxLength": 256
        },
        "parser_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "transform_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "relation"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "relation": {
          "enum": [
            "SUPPORTS",
            "QUALIFIES",
            "CONTRADICTS",
            "CONTEXT"
          ]
        }
      }
    },
    "page_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_more"
      ],
      "properties": {
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "has_more": {
          "type": "boolean"
        }
      }
    }
  }
}
