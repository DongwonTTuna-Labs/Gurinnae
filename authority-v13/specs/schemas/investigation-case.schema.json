{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gurine.invalid/investigation-case.schema.json",
  "title": "InvestigationCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_number",
    "investigation_state",
    "publication_state",
    "resolution_code",
    "version",
    "risk_level",
    "signal_ids",
    "subjects",
    "hypotheses",
    "evidence",
    "claims",
    "response_summary",
    "review_requirements",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "case_number": {
      "type": "string",
      "pattern": "^GRN-[0-9]{4}-[0-9]{6}$"
    },
    "investigation_state": {
      "enum": [
        "SIGNAL_DETECTED",
        "TRIAGE",
        "INVESTIGATING",
        "AWAITING_RESPONSE",
        "EDITORIAL_REVIEW",
        "LEGAL_REVIEW",
        "READY_TO_PUBLISH",
        "CLOSED"
      ]
    },
    "publication_state": {
      "enum": [
        "NEVER_PUBLISHED",
        "PUBLISHED_ANOMALY",
        "PUBLISHED_EXPLAINED",
        "OFFICIALLY_CONFIRMED",
        "CORRECTED",
        "RETRACTED",
        "TEMPORARILY_RESTRICTED"
      ]
    },
    "resolution_code": {
      "enum": [
        "NONE",
        "DATA_ERROR",
        "DUPLICATE",
        "EXPLAINED",
        "INSUFFICIENT_EVIDENCE",
        "REFERRED_CONFIDENTIAL",
        "ARCHIVED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "risk_level": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "PROHIBITED"
      ]
    },
    "signal_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "display_name",
          "identity_status"
        ],
        "properties": {
          "type": {
            "enum": [
              "AGENCY",
              "SUPPLIER",
              "CONTRACT",
              "NOTICE"
            ]
          },
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "identity_status": {
            "enum": [
              "VERIFIED",
              "AMBIGUOUS",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "owner_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "conflict_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "legal_risk_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "NAMED_INDIVIDUAL",
          "SOLE_PROPRIETOR_PERSONAL_IDENTITY",
          "CRIMINAL_IMPLICATION",
          "COLLUSION_OR_BRIBERY_LANGUAGE",
          "ELECTION_OR_POLITICAL_ACTOR",
          "NATIONAL_SECURITY",
          "ONGOING_INVESTIGATION",
          "MINOR_OR_VULNERABLE_PERSON",
          "MEDICAL_OR_SENSITIVE_PERSONAL_DATA",
          "CONFIDENTIAL_RESPONSE",
          "SOURCE_LICENSE_UNCLEAR",
          "UPSTREAM_REMOVAL_REQUEST",
          "COURT_ORDER_OR_INJUNCTION",
          "WHISTLEBLOWER_RISK"
        ]
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "kind",
          "statement",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "hypothesis_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "kind": {
            "enum": [
              "PRIMARY",
              "ALTERNATIVE",
              "NULL"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "status": {
            "enum": [
              "OPEN",
              "SUPPORTED",
              "CONTRADICTED",
              "RESOLVED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidence_ref"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_type",
          "text_ko",
          "status",
          "evidence_refs",
          "risk_flags",
          "version"
        ],
        "properties": {
          "claim_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "claim_type": {
            "enum": [
              "FACT",
              "CALCULATION",
              "INFERENCE",
              "LIMITATION",
              "OFFICIAL_OUTCOME"
            ]
          },
          "text_ko": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "status": {
            "enum": [
              "DRAFT",
              "VALID",
              "BLOCKED",
              "SUPERSEDED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidence_ref"
            }
          },
          "risk_flags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "response_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "NOT_REQUIRED",
            "NOT_SENT",
            "SENT",
            "DELIVERED",
            "RECEIVED",
            "INCORPORATED",
            "CLOSED_NO_RESPONSE"
          ]
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "response_request_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      }
    },
    "review_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editor_count",
        "legal_required",
        "response_required"
      ],
      "properties": {
        "editor_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "legal_required": {
          "type": "boolean"
        },
        "response_required": {
          "type": "boolean"
        }
      }
    },
    "review_snapshot_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
