{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurine.invalid/events/claim.validated.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_id",
    "claimId",
    "occurred_at",
    "operation_id",
    "request_id"
  ],
  "properties": {
    "actor_id": {
      "type": "string"
    },
    "claimId": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "operation_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    }
  }
}
