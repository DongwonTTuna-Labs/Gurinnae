  "query": "SELECT c.public_slug,c.title,c.summary,s.snapshot_payload,CASE WHEN c.publication_state='NEVER_PUBLISHED' AND c.resolution_code='EXPLAINED' THEN 'PUBLISHED_EXPLAINED' WHEN c.publication_state='NEVER_PUBLISHED' THEN 'PUBLISHED_ANOMALY' ELSE c.publication_state::text END \"public_state!\" FROM editorial.cases c JOIN editorial.review_snapshots s ON s.case_id=c.id WHERE c.id=$1 AND s.id=$2",
