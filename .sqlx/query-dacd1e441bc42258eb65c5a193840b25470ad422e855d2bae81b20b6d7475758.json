{
  "db_name": "PostgreSQL",
  "query": "SELECT i.supplier_id,i.scheme,btrim(i.value_hash) AS \"value_hmac!\", i.verification_status,i.proof_state, btrim(i.identifier_fact_digest) AS \"identifier_fact_digest!\" FROM core.supplier_identifiers i WHERE i.value_hash=$1 AND i.verification_status='VERIFIED' AND i.proof_state='PROVEN_V1' AND i.identifier_fact_digest IS NOT NULL AND i.scheme IN ('KOREAN_BUSINESS_NUMBER','OPEN_DART_CORP_CODE','KONEPS_PARTY_KEY') ORDER BY i.supplier_id,i.scheme,i.identifier_fact_digest",
