  "query": "SELECT id,job_type,queue,payload,attempt_count,max_attempts FROM ops.jobs WHERE queue=$1 AND status='QUEUED' AND run_after<=clock_timestamp() AND COALESCE((SELECT state FROM ops.queue_controls WHERE queue_name=queue),'RUNNING')='RUNNING' ORDER BY priority,created_at,id FOR UPDATE SKIP LOCKED LIMIT 1",
