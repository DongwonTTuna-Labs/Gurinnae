  "query": "SELECT x.id,x.source_revision,x.target_revision,x.summary,x.reason,x.published_at,c.slug,c.public_state,r.payload FROM public.corrections x JOIN public.cases c ON c.id=x.case_id JOIN public.case_revisions r ON r.case_id=c.id AND r.revision=c.latest_revision WHERE x.id=$1",
