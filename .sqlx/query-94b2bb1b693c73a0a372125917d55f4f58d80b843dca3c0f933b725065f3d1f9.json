  "query": "SELECT c.public_slug,c.title,btrim(a.sigungu_code::text) AS \"sigungu_code?\" FROM editorial.cases c LEFT JOIN editorial.publication_revisions r ON r.case_id=c.id AND r.review_snapshot_id=$2 LEFT JOIN core.agencies a ON a.id::text=r.public_payload->>'agencyId' WHERE c.id=$1",
