  "query": "SELECT c.slug,c.title,c.public_state,c.summary,c.latest_revision,c.updated_at FROM public.cases c JOIN public.case_revisions r ON r.case_id=c.id AND r.revision=c.latest_revision WHERE r.payload->>$1=$3 OR COALESCE(r.payload->$2,'[]'::jsonb) ? $3 ORDER BY c.updated_at DESC LIMIT 5",
