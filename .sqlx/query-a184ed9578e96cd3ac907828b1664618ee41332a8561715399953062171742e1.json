{
  "db_name": "PostgreSQL",
  "query": "UPDATE ops.provider_model_upgrade_attempts a SET status='RUNNING',started_at=COALESCE(started_at,clock_timestamp()) FROM ops.provider_configs p,ops.relay_model_catalog m WHERE a.id=$1 AND a.provider_id=p.id AND a.target_model_id=m.model_id AND a.status IN ('QUEUED','RUNNING') AND p.provider_type='relay' AND p.version=a.expected_provider_version AND m.active RETURNING a.provider_id,a.target_model_id,a.attempt_kind,a.owner_user_id, a.expected_provider_version,a.requested_data_policy,a.connection_test_id, p.routing_policy,m.track",
