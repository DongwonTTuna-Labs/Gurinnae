  "query": "SELECT c.version,c.current_review_snapshot_id,s.snapshot_sha256,s.unresolved_blockers, EXISTS(SELECT 1 FROM editorial.review_decisions d WHERE d.review_snapshot_id=s.id AND d.decision='APPROVE' AND d.reviewer_id<>s.created_by) approved, EXISTS(SELECT 1 FROM ops.kill_switches WHERE state='ACTIVE' AND (expires_at IS NULL OR expires_at>clock_timestamp())) kill_switch FROM editorial.cases c JOIN editorial.review_snapshots s ON s.id=$2 AND s.case_id=c.id WHERE c.id=$1",
