  "query": "SELECT s.source_id,s.schedule_cron,MAX(r.scheduled_for) AS last_scheduled_for FROM ops.source_registry s LEFT JOIN ops.source_runs r ON r.source_id=s.source_id WHERE s.enabled AND s.legal_status='APPROVED' GROUP BY s.source_id,s.schedule_cron ORDER BY s.source_id",
