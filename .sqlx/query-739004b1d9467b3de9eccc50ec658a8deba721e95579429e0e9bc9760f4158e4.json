  "query": "SELECT run.version,receipt.receipt_id,receipt.receipt_sha256 FROM ops.agent_runs AS run JOIN LATERAL (SELECT receipt_id,receipt_sha256 FROM ops.agent_run_control_receipts WHERE agent_run_id=run.id ORDER BY aggregate_version DESC LIMIT 1) AS receipt ON true WHERE run.id=$1 AND run.run_contract_version=2 AND run.status='RUNNING'",
