  "query": "UPDATE ops.provider_connection_tests t SET status='RUNNING',            started_at=COALESCE(started_at,clock_timestamp())          FROM ops.provider_configs p WHERE t.id=$1 AND t.provider_id=p.id            AND t.status IN ('QUEUED','RUNNING')          RETURNING t.provider_id,t.test_model,p.provider_type,p.enabled,p.routing_policy",
