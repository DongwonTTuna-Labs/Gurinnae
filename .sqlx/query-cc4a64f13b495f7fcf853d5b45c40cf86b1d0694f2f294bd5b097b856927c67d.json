  "query": "SELECT suggestion.case_id,suggestion.suggestion_type,suggestion.payload, suggestion.payload_sha256,suggestion.input_snapshot_sha256, suggestion.version AS suggestion_version, current_case.version AS case_version FROM ops.agent_suggestions AS suggestion JOIN editorial.cases AS current_case ON current_case.id=suggestion.case_id WHERE suggestion.id=$1 AND suggestion.status='PENDING' FOR UPDATE OF suggestion FOR SHARE OF current_case",
