{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id,a.name AS \"name!\",a.agency_type,a.jurisdiction,a.sido_code,a.sigungu_code,a.region_code_version,a.coverage,a.case_counts,a.updated_at FROM public.agencies a WHERE a.name IS NOT NULL AND ($1='' OR a.name ILIKE '%'||$1||'%') AND (cardinality($2::text[])=0 OR a.agency_type=ANY($2)) AND ($3='' OR a.jurisdiction=$3) ORDER BY CASE WHEN $4='name_asc' THEN a.name END ASC,CASE WHEN $4='updated_desc' THEN a.updated_at END DESC,CASE WHEN $4='contract_count_desc' THEN (SELECT count(*) FROM public.contracts c WHERE c.agency_id=a.id) END DESC,a.id LIMIT $5 OFFSET $6",
