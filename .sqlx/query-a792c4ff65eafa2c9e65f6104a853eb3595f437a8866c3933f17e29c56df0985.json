  "query": "SELECT id,occurred_at,actor_type,actor_id,action,object_type,object_id,capability,          outcome::text AS \"outcome?\",reason,request_id,details,event_hash,previous_event_hash          FROM ops.audit_events WHERE occurred_at >= $1 AND occurred_at <= $2            AND ($3='GLOBAL' OR ($3='CASE' AND object_type='case' AND object_id=$5)              OR ($3='OBJECT' AND upper(object_type)=upper($4) AND object_id=$5))          ORDER BY occurred_at,id LIMIT 1000001",
