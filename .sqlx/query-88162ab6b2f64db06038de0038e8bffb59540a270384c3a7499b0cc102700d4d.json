  "query": "UPDATE core.rule_evaluations e SET status='RUNNING',            started_at=COALESCE(started_at,clock_timestamp())          FROM core.rule_versions v WHERE e.id=$1 AND e.rule_version_id=v.id            AND e.status IN ('QUEUED','RUNNING')          RETURNING e.rule_version_id,e.dataset_snapshot_id,v.rule_id,v.configuration",
