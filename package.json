{
  "name": "gurine",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "test:e2e": "playwright test tests/e2e/routes.spec.ts tests/e2e/browser-identity.spec.ts",
    "test:visual": "playwright test tests/e2e/visual-routes.spec.ts",
    "codegen": "bun run scripts/generate-clients.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "typescript": "5.9.3"
  }
}
