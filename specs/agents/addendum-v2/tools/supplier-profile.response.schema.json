{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/schemas/agents/v2/tools/supplier-profile-response.json",
  "title": "SupplierProfileResponseV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile"],
  "properties": {
    "schemaVersion": { "const": "supplier.profile.response.v2" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplierId",
        "canonicalName",
        "businessStatus",
        "identityStatus",
        "contractCount",
        "snapshotMemberId",
        "snapshotMemberDigest",
        "sourceUseId"
      ],
      "properties": {
        "supplierId": { "type": "string", "format": "uuid" },
        "canonicalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "businessStatus": { "type": ["string", "null"], "maxLength": 200 },
        "identityStatus": {
          "enum": [
            "UNVERIFIED",
            "CANDIDATE",
            "VERIFIED",
            "AMBIGUOUS",
            "CONFLICTED",
            "REJECTED"
          ]
        },
        "contractCount": { "type": "integer", "minimum": 0 },
        "snapshotMemberId": { "type": "string", "format": "uuid" },
        "snapshotMemberDigest": { "$ref": "#/$defs/sha256" },
        "sourceUseId": { "type": "string", "format": "uuid" }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
  "x-gurinnae-invariants": [
    "The profile is read from the exact immutable SUPPLIER snapshot member.",
    "No natural-person attribute, score, or family relationship is returned."
  ]
}
