{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/schemas/agents/v2/tools/relationship-neighbors-request.json",
  "title": "RelationshipNeighborsRequestV2OrV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "inputSnapshotId",
    "inputSnapshotSha256",
    "relationshipKinds",
    "asOf",
    "limit"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "relationship.neighbors.request.v2",
        "relationship.neighbors.request.v3"
      ]
    },
    "runId": { "type": "string", "format": "uuid" },
    "inputSnapshotId": { "type": "string", "format": "uuid" },
    "inputSnapshotSha256": { "$ref": "#/$defs/sha256" },
    "supplierId": { "type": "string", "format": "uuid" },
    "selector": { "$ref": "#/$defs/typedSelector" },
    "relationshipKinds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 9
    },
    "asOf": {
      "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
  },
  "oneOf": [
    {
      "required": ["supplierId"],
      "properties": {
        "schemaVersion": { "const": "relationship.neighbors.request.v2" },
        "supplierId": { "type": "string", "format": "uuid" },
        "relationshipKinds": {
          "maxItems": 6,
          "items": { "$ref": "#/$defs/relationshipKindV2" }
        }
      },
      "not": {
        "required": ["selector"],
        "properties": { "selector": {} }
      }
    },
    {
      "required": ["selector"],
      "properties": {
        "schemaVersion": { "const": "relationship.neighbors.request.v3" },
        "selector": { "$ref": "#/$defs/typedSelector" },
        "relationshipKinds": {
          "maxItems": 9,
          "items": { "$ref": "#/$defs/relationshipKindV3" }
        }
      },
      "not": {
        "required": ["supplierId"],
        "properties": { "supplierId": {} }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relationshipKindV2": {
      "enum": [
        "OWNERSHIP",
        "BENEFICIAL_OWNERSHIP",
        "CONTROL",
        "MANAGEMENT_ROLE",
        "LEGAL_REPRESENTATIVE",
        "CONTRACTUAL_RELATIONSHIP"
      ]
    },
    "relationshipKindV3": {
      "enum": [
        "OWNERSHIP",
        "BENEFICIAL_OWNERSHIP",
        "CONTROL",
        "MANAGEMENT_ROLE",
        "LEGAL_REPRESENTATIVE",
        "CONTRACTUAL_RELATIONSHIP",
        "BID_PARTICIPATION",
        "SANCTION",
        "FORMER_OFFICIAL_ROLE"
      ]
    },
    "typedSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "endpointId"],
          "properties": {
            "kind": {
              "enum": ["SUPPLIER", "AGENCY", "PROCUREMENT_NOTICE", "SANCTION"]
            },
            "endpointId": { "type": "string", "format": "uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "personNodeRef"],
          "properties": {
            "kind": { "const": "PERSON" },
            "personNodeRef": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    }
  },
  "x-gurinnae-invariants": [
    "V2 remains the supplier-only compatibility request and V3 is the typed graph request.",
    "V3 endpoint kinds are exactly SUPPLIER, PERSON, AGENCY, PROCUREMENT_NOTICE, and SANCTION.",
    "A PERSON selector accepts only a run-and-snapshot-scoped opaque personNodeRef. The database rejects a ref minted for another run or snapshot; contextual names, titles, source locators, hidden endpoint identities, identifier fact digests, family data, scores, ranks, and probabilities are forbidden.",
    "Only independently VERIFIED assertions with publicUseStatus APPROVED and exact READY snapshot source-use bindings may be returned."
  ]
}
