{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/schemas/agents/v2/tools/rule-reproduce-response.json",
  "title": "RuleReproduceResponseV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reproduction",
    "steps",
    "inputMemberBindings",
    "sourceUseBindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rule.reproduce.response.v2"
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleRunId",
        "ruleId",
        "ruleVersionId",
        "inputDigest",
        "resultDigest",
        "outcome",
        "signalId",
        "signalVersion",
        "matchedConditionCodes",
        "computedAt"
      ],
      "properties": {
        "ruleRunId": {
          "type": "string",
          "format": "uuid"
        },
        "ruleId": {
          "type": "string",
          "format": "uuid"
        },
        "ruleVersionId": {
          "type": "string",
          "format": "uuid"
        },
        "inputDigest": {
          "$ref": "#/$defs/sha256"
        },
        "resultDigest": {
          "$ref": "#/$defs/sha256"
        },
        "outcome": {
          "enum": [
            "MATCH",
            "NO_MATCH",
            "INSUFFICIENT_DATA",
            "RULE_ERROR"
          ]
        },
        "signalId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "signalVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "matchedConditionCodes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        },
        "computedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "conditionCode",
          "description",
          "inputFieldBindings",
          "operator",
          "result",
          "stepDigest"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "conditionCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "inputFieldBindings": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "snapshotMemberId",
                "fieldPath",
                "fieldValueSha256",
                "fieldProvenanceId"
              ],
              "properties": {
                "snapshotMemberId": {
                  "type": "string",
                  "format": "uuid"
                },
                "fieldPath": {
                  "type": "string",
                  "pattern": "^/",
                  "maxLength": 512
                },
                "fieldValueSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "fieldProvenanceId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                }
              }
            }
          },
          "operator": {
            "enum": [
              "EQUAL",
              "NOT_EQUAL",
              "GREATER_THAN",
              "GREATER_OR_EQUAL",
              "LESS_THAN",
              "LESS_OR_EQUAL",
              "IN_SET",
              "RATIO",
              "DATE_DISTANCE",
              "EXISTS"
            ]
          },
          "result": {
            "enum": [
              "TRUE",
              "FALSE",
              "UNKNOWN",
              "ERROR"
            ]
          },
          "stepDigest": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "inputMemberBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshotMemberId",
          "snapshotMemberDigest"
        ],
        "properties": {
          "snapshotMemberId": {
            "type": "string",
            "format": "uuid"
          },
          "snapshotMemberDigest": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "sourceUseBindings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceUseId",
          "sourceUseSha256"
        ],
        "properties": {
          "sourceUseId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceUseSha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
