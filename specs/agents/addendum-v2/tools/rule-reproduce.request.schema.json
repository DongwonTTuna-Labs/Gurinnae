{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/schemas/agents/v2/tools/rule-reproduce-request.json",
  "title": "RuleReproduceRequestV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "inputSnapshotId", "inputSnapshotSha256", "ruleId", "ruleVersionId", "ruleCodeSha256", "ruleConfigurationSha256", "detectionSnapshotId", "detectionSnapshotSha256", "subjectMembers", "expectedSignalId", "traceLevel"],
  "properties": {
    "schemaVersion": {"const": "rule.reproduce.request.v2"},
    "runId": {"type": "string", "format": "uuid"},
    "inputSnapshotId": {"type": "string", "format": "uuid"},
    "inputSnapshotSha256": {"$ref": "#/$defs/sha256"},
    "ruleId": {"type": "string", "format": "uuid"},
    "ruleVersionId": {"type": "string", "format": "uuid"},
    "ruleCodeSha256": {"$ref": "#/$defs/sha256"},
    "ruleConfigurationSha256": {"$ref": "#/$defs/sha256"},
    "detectionSnapshotId": {"type": "string", "format": "uuid"},
    "detectionSnapshotSha256": {"$ref": "#/$defs/sha256"},
    "subjectMembers": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["snapshotMemberId", "snapshotMemberDigest", "objectType", "objectId", "objectVersion"], "properties": {"snapshotMemberId": {"type": "string", "format": "uuid"}, "snapshotMemberDigest": {"$ref": "#/$defs/sha256"}, "objectType": {"enum": ["CONTRACT", "CONTRACT_LINE_ITEM", "CONTRACT_CHANGE", "PRICE_OBSERVATION", "AGENCY", "SUPPLIER"]}, "objectId": {"type": "string", "format": "uuid"}, "objectVersion": {"type": "integer", "minimum": 1}}}},
    "expectedSignalId": {"type": ["string", "null"], "format": "uuid"},
    "traceLevel": {"enum": ["SUMMARY", "DECISION_STEPS", "FULL_SAFE_TRACE"]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
