{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/schemas/agents/v2/tools/evidence-search-request.json",
  "title": "EvidenceSearchRequestV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "inputSnapshotId", "inputSnapshotSha256", "query", "queryLanguage", "evidenceTypes", "verificationStates", "classifications", "sourceAuthorities", "sort", "cursor", "limit"],
  "properties": {
    "schemaVersion": {"const": "evidence.search.request.v2"},
    "runId": {"type": "string", "format": "uuid"},
    "inputSnapshotId": {"type": "string", "format": "uuid"},
    "inputSnapshotSha256": {"$ref": "#/$defs/sha256"},
    "query": {"type": "string", "minLength": 1, "maxLength": 2000},
    "queryLanguage": {"enum": ["ko", "en", "mixed"]},
    "evidenceTypes": {"type": "array", "uniqueItems": true, "maxItems": 32, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}},
    "verificationStates": {"type": "array", "uniqueItems": true, "items": {"enum": ["PENDING", "VERIFIED", "REJECTED", "NEEDS_WORK"]}},
    "classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PUBLIC", "INTERNAL", "RESTRICTED"]}},
    "sourceAuthorities": {"type": "array", "uniqueItems": true, "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
    "sort": {"enum": ["RELEVANCE", "NEWEST_SOURCE", "OLDEST_SOURCE"]},
    "cursor": {"type": ["string", "null"], "maxLength": 2048},
    "limit": {"type": "integer", "minimum": 1, "maximum": 50}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
