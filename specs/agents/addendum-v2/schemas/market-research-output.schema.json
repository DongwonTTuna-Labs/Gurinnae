{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/schemas/agents/v2/market-research-output.json",
  "title": "MarketResearchOutputV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outcome",
    "summary",
    "investigationsPerformed",
    "citations",
    "unknowns",
    "nextActions",
    "abstentionReasons",
    "comparables"
  ],
  "properties": {
    "schemaVersion": {
      "const": "market-research-output.v2"
    },
    "outcome": {
      "enum": ["COMPLETED", "ABSTAINED"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "investigationsPerformed": {
      "type": "array",
      "minItems": 0,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/investigation"
      }
    },
    "citations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nextAction"
      }
    },
    "abstentionReasons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/abstentionReason"
      }
    },
    "comparables": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/comparableDraft"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "COMPLETED"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "abstentionReasons": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ABSTAINED"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "abstentionReasons": {
            "minItems": 1
          },
          "comparables": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "locatorSha256"],
      "properties": {
        "kind": {
          "enum": [
            "PAGE_BBOX",
            "XLSX_CELL",
            "CSV_ROW_COLUMN",
            "XML_XPATH",
            "DOCX_PARAGRAPH",
            "HWPX_XPATH",
            "JSON_POINTER",
            "HTML_CSS_SELECTOR",
            "API_FIELD",
            "TEXT_RANGE",
            "IMAGE_BBOX",
            "AUDIO_TIME_RANGE",
            "VIDEO_TIME_RANGE",
            "VIDEO_REGION_TIME"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "locatorSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceUseSha256",
        "locator",
        "selectedContentSha256",
        "supports",
        "supportsSha256"
      ],
      "properties": {
        "sourceUseSha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "selectedContentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "supports": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "supportsSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolId", "objective", "resultSummary", "toolResultSha256"],
      "properties": {
        "toolId": {
          "enum": [
            "agency.profile",
            "contract.search",
            "evidence.search",
            "relationship.neighbors",
            "source.fetch",
            "supplier.profile",
            "contract.find_comparables"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "resultSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "toolResultSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "unknown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionType",
        "reason",
        "targetDescription",
        "requiresHumanDecision"
      ],
      "properties": {
        "actionType": {
          "enum": [
            "COLLECT_SOURCE",
            "VERIFY_EVIDENCE",
            "REQUEST_RESPONSE",
            "REVIEW_HYPOTHESIS",
            "REVIEW_CLAIM",
            "REVIEW_COMPARABLE",
            "PROMOTE_RESEARCH_ARTIFACT",
            "NO_ACTION"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "targetDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "requiresHumanDecision": {
          "type": "boolean"
        }
      }
    },
    "abstentionReason": {
      "enum": [
        "UNTRUSTED_INSTRUCTION_DETECTED",
        "CITATION_REQUIRED",
        "BUDGET_EXHAUSTED",
        "PROVIDER_UNAVAILABLE",
        "EVIDENCE_OUTSIDE_SNAPSHOT",
        "TOOL_NOT_ALLOWED",
        "CITATION_LOCATOR_MISMATCH",
        "EVIDENCE_SNAPSHOT_STALE",
        "ITERATION_LIMIT_REACHED",
        "INSUFFICIENT_EVIDENCE",
        "TOOL_RESULT_INCOMPLETE"
      ]
    },
    "citationIndexes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999
      }
    },
    "comparableDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalKind",
        "proposalState",
        "subjectDescription",
        "candidateDescription",
        "sourceUrl",
        "observedAt",
        "unit",
        "unitPriceDecimal",
        "currencyCode",
        "compatibility",
        "comparisonBasis",
        "materialDifferences",
        "limitations",
        "citationIndexes"
      ],
      "properties": {
        "proposalKind": {
          "const": "COMPARABLE"
        },
        "proposalState": {
          "const": "PROPOSAL_ONLY"
        },
        "subjectDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "candidateDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 4096
        },
        "observedAt": {
          "type": "string",
          "format": "date",
          "minLength": 10,
          "maxLength": 10
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "unitPriceDecimal": {
          "type": "string",
          "pattern": "^[0-9]{1,18}([.][0-9]{1,6})?$",
          "minLength": 1,
          "maxLength": 25
        },
        "currencyCode": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "minLength": 3,
          "maxLength": 3
        },
        "compatibility": {
          "enum": ["POTENTIAL", "INCOMPATIBLE", "UNKNOWN"]
        },
        "comparisonBasis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "materialDifferences": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "citationIndexes": {
          "$ref": "#/$defs/citationIndexes"
        }
      }
    }
  },
  "x-gurinnae-invariants": [
    "Every citation is a provider draft bound to an existing run source use by sourceUseSha256; the server re-extracts locator bytes and verifies selectedContentSha256 plus supportsSha256 before assigning any citation or proposal ID.",
    "citationIndexes are zero-based indexes into this output's citations array, contain no server identifier, and must resolve in range without duplicates.",
    "Comparables remain unverified proposal-only candidates; this output cannot approve, publish, authorize, deliver, contact a party, or mutate authoritative state.",
    "The server derives every runtime identifier, status, approval, authentication, authorization, and delivery receipt; none may be accepted from provider output."
  ]
}
