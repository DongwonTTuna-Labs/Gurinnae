{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/schemas/agents/v2/agent-run.json",
  "title": "AgentRunV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "runContractVersion",
    "caseId",
    "agentType",
    "objective",
    "status",
    "controlState",
    "datasetSnapshot",
    "initialTranscriptSha256",
    "prompt",
    "outputSchema",
    "providerPolicy",
    "budget",
    "iterations",
    "outputValidationId",
    "failureCode",
    "createdBy",
    "version",
    "createdAt",
    "startedAt",
    "completedAt",
    "updatedAt",
    "terminalReceiptSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-run.v2" },
    "id": { "type": "string", "format": "uuid" },
    "runContractVersion": { "const": 2 },
    "caseId": { "type": "string", "format": "uuid" },
    "agentType": {
      "enum": [
        "market-researcher",
        "investigator",
        "skeptic",
        "claim-drafter",
        "citation-verifier"
      ]
    },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "BUDGET_BLOCKED",
        "POLICY_BLOCKED"
      ]
    },
    "controlState": {
      "enum": [
        "NONE",
        "ACTIVE",
        "CANCEL_REQUESTED",
        "RECONCILIATION_REQUIRED",
        "SETTLED"
      ]
    },
    "datasetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "state",
        "snapshotSha256",
        "memberCount",
        "readyAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "kind": { "const": "AGENT_CASE" },
        "state": { "const": "READY" },
        "snapshotSha256": { "$ref": "#/$defs/sha256" },
        "memberCount": { "type": "integer", "minimum": 1 },
        "readyAt": { "type": "string", "format": "date-time" }
      }
    },
    "initialTranscriptSha256": { "$ref": "#/$defs/sha256" },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "providerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "classification", "candidateIds"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "RESTRICTED",
            "PERSONAL_DATA",
            "LEGAL_HOLD"
          ]
        },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "maxMicrosKrw",
        "reservedMicrosKrw",
        "settledMicrosKrw",
        "remainingMicrosKrw",
        "reservationState",
        "budgetPolicyVersion",
        "budgetPolicySha256"
      ],
      "properties": {
        "currency": { "const": "KRW" },
        "maxMicrosKrw": { "type": "integer", "minimum": 0 },
        "reservedMicrosKrw": { "type": "integer", "minimum": 0 },
        "settledMicrosKrw": { "type": "integer", "minimum": 0 },
        "remainingMicrosKrw": { "type": "integer", "minimum": 0 },
        "reservationState": {
          "enum": [
            "NONE",
            "RESERVED",
            "PARTIALLY_SETTLED",
            "SETTLED",
            "RELEASED",
            "RECONCILIATION_REQUIRED"
          ]
        },
        "budgetPolicyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "budgetPolicySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "iterations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxProviderTurns",
        "maxToolCalls",
        "completedProviderTurns",
        "completedToolCalls",
        "nextTurnSequence",
        "deadlineAt"
      ],
      "properties": {
        "maxProviderTurns": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxToolCalls": { "type": "integer", "minimum": 0, "maximum": 32 },
        "completedProviderTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "completedToolCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "nextTurnSequence": { "type": "integer", "minimum": 1, "maximum": 33 },
        "deadlineAt": { "type": "string", "format": "date-time" }
      }
    },
    "outputValidationId": { "type": ["string", "null"], "format": "uuid" },
    "failureCode": {
      "type": ["string", "null"],
      "enum": [
        null,
        "OUTPUT_SCHEMA_INVALID",
        "PROVIDER_UNAVAILABLE",
        "INTERNAL_EXECUTION_FAILED",
        "CITATION_INVALID",
        "RIGHTS_DENIED",
        "CLASSIFICATION_DENIED",
        "ITERATION_LIMIT_REACHED",
        "CANCELLED_BY_USER",
        "RECONCILIATION_FAILED",
        "BUDGET_RESERVATION_DENIED",
        "POLICY_DENIED"
      ]
    },
    "createdBy": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "terminalReceiptSha256": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "QUEUED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "controlState": { "const": "NONE" },
          "startedAt": { "type": "null" },
          "completedAt": { "type": "null" },
          "terminalReceiptSha256": { "type": "null" },
          "outputValidationId": { "type": "null" },
          "failureCode": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "RUNNING" } } },
      "then": {
        "properties": {
          "controlState": {
            "enum": ["ACTIVE", "CANCEL_REQUESTED", "RECONCILIATION_REQUIRED"]
          },
          "startedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "null" },
          "terminalReceiptSha256": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "SUCCEEDED",
              "FAILED",
              "CANCELLED",
              "BUDGET_BLOCKED",
              "POLICY_BLOCKED"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "controlState": { "const": "SETTLED" },
          "completedAt": { "type": "string", "format": "date-time" },
          "terminalReceiptSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "SUCCEEDED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "startedAt": { "type": "string", "format": "date-time" },
          "outputValidationId": { "type": "string", "format": "uuid" },
          "failureCode": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "FAILED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "startedAt": { "type": "string", "format": "date-time" },
          "failureCode": { "type": "string" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "CANCELLED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "failureCode": { "const": "CANCELLED_BY_USER" },
          "outputValidationId": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "BUDGET_BLOCKED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "startedAt": { "type": "null" },
          "failureCode": { "const": "BUDGET_RESERVATION_DENIED" },
          "outputValidationId": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "POLICY_BLOCKED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "failureCode": {
            "enum": ["RIGHTS_DENIED", "CLASSIFICATION_DENIED", "POLICY_DENIED"]
          },
          "outputValidationId": { "type": "null" }
        }
      }
    }
  ],
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
  "x-gurinnae-invariants": [
    "budget.reservedMicrosKrw + budget.settledMicrosKrw + budget.remainingMicrosKrw never exceeds budget.maxMicrosKrw and every reservation transition is receipt-backed.",
    "iterations.completedProviderTurns is no greater than maxProviderTurns, completedToolCalls is no greater than maxToolCalls, and nextTurnSequence equals completedProviderTurns + 1.",
    "createdAt <= startedAt <= completedAt when those timestamps exist, updatedAt is not earlier than any persisted transition, and every timestamp is canonical UTC Z.",
    "A terminal run has no open provider/tool effect claim and every budget reservation is SETTLED or RELEASED; elapsed time alone never proves cancellation or failure."
  ]
}
