{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/schemas/agents/v2/investigator-output.json",
  "title": "InvestigatorOutputV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outcome",
    "summary",
    "investigationsPerformed",
    "citations",
    "unknowns",
    "nextActions",
    "abstentionReasons",
    "hypotheses",
    "counterEvidence",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "investigator-output.v2"
    },
    "outcome": {
      "enum": ["COMPLETED", "ABSTAINED"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "investigationsPerformed": {
      "type": "array",
      "minItems": 0,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/investigation"
      }
    },
    "citations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nextAction"
      }
    },
    "abstentionReasons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/abstentionReason"
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hypothesisDraft"
      }
    },
    "counterEvidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/counterEvidenceItem"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taskDraft"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "COMPLETED"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "abstentionReasons": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ABSTAINED"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "abstentionReasons": {
            "minItems": 1
          },
          "hypotheses": {
            "maxItems": 0
          },
          "counterEvidence": {
            "maxItems": 0
          },
          "tasks": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "locatorSha256"],
      "properties": {
        "kind": {
          "enum": [
            "PAGE_BBOX",
            "XLSX_CELL",
            "CSV_ROW_COLUMN",
            "XML_XPATH",
            "DOCX_PARAGRAPH",
            "HWPX_XPATH",
            "JSON_POINTER",
            "HTML_CSS_SELECTOR",
            "API_FIELD",
            "TEXT_RANGE",
            "IMAGE_BBOX",
            "AUDIO_TIME_RANGE",
            "VIDEO_TIME_RANGE",
            "VIDEO_REGION_TIME"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "locatorSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceUseSha256",
        "locator",
        "selectedContentSha256",
        "supports",
        "supportsSha256"
      ],
      "properties": {
        "sourceUseSha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "selectedContentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "supports": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "supportsSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolId", "objective", "resultSummary", "toolResultSha256"],
      "properties": {
        "toolId": {
          "enum": [
            "evidence.search",
            "evidence.read",
            "contract.find_comparables",
            "entity.lookup"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "resultSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "toolResultSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "unknown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionType",
        "reason",
        "targetDescription",
        "requiresHumanDecision"
      ],
      "properties": {
        "actionType": {
          "enum": [
            "COLLECT_SOURCE",
            "VERIFY_EVIDENCE",
            "REQUEST_RESPONSE",
            "REVIEW_HYPOTHESIS",
            "REVIEW_CLAIM",
            "REVIEW_COMPARABLE",
            "PROMOTE_RESEARCH_ARTIFACT",
            "NO_ACTION"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "targetDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "requiresHumanDecision": {
          "type": "boolean"
        }
      }
    },
    "abstentionReason": {
      "enum": [
        "UNTRUSTED_INSTRUCTION_DETECTED",
        "CITATION_REQUIRED",
        "BUDGET_EXHAUSTED",
        "PROVIDER_UNAVAILABLE",
        "EVIDENCE_OUTSIDE_SNAPSHOT",
        "TOOL_NOT_ALLOWED",
        "CITATION_LOCATOR_MISMATCH",
        "EVIDENCE_SNAPSHOT_STALE",
        "ITERATION_LIMIT_REACHED",
        "INSUFFICIENT_EVIDENCE",
        "TOOL_RESULT_INCOMPLETE"
      ]
    },
    "citationIndexes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999
      }
    },
    "nonEmptyCitationIndexes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999
      }
    },
    "hypothesisDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalKind",
        "proposalState",
        "statement",
        "assessment",
        "supportingCitationIndexes",
        "contradictingCitationIndexes",
        "unknowns"
      ],
      "properties": {
        "proposalKind": {
          "const": "HYPOTHESIS"
        },
        "proposalState": {
          "const": "PROPOSAL_ONLY"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "assessment": {
          "enum": ["SUPPORTED", "CONTRADICTED", "UNRESOLVED"]
        },
        "supportingCitationIndexes": {
          "$ref": "#/$defs/citationIndexes"
        },
        "contradictingCitationIndexes": {
          "$ref": "#/$defs/citationIndexes"
        },
        "unknowns": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/unknown"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "supportingCitationIndexes": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "contradictingCitationIndexes": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "taskDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalKind",
        "proposalState",
        "title",
        "description",
        "priority",
        "duePolicy",
        "citationIndexes"
      ],
      "properties": {
        "proposalKind": {
          "const": "TASK"
        },
        "proposalState": {
          "const": "PROPOSAL_ONLY"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "priority": {
          "enum": ["LOW", "NORMAL", "HIGH", "URGENT"]
        },
        "duePolicy": {
          "enum": [
            "WITHIN_24_HOURS",
            "WITHIN_3_DAYS",
            "WITHIN_7_DAYS",
            "BEFORE_PUBLICATION"
          ]
        },
        "citationIndexes": {
          "$ref": "#/$defs/nonEmptyCitationIndexes"
        }
      }
    },
    "counterEvidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "impact", "citationIndexes"],
      "properties": {
        "kind": {
          "const": "COUNTER_EVIDENCE"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "impact": {
          "enum": ["WEAKENS", "CONTRADICTS", "CONTEXT_ONLY"]
        },
        "citationIndexes": {
          "$ref": "#/$defs/nonEmptyCitationIndexes"
        }
      }
    }
  },
  "x-gurinnae-invariants": [
    "Every citation is bound to an existing run source use by sourceUseSha256; the server re-extracts locator bytes and verifies selectedContentSha256 plus supportsSha256 before assigning any citation or proposal ID.",
    "All citation index arrays are zero-based references into this output's citations array and must resolve in range; they are provider-local ordinals, never server identifiers.",
    "Hypotheses are proposal-only drafts and assessments are research labels, not authoritative findings or case-state decisions.",
    "The server derives every runtime identifier, status, approval, authentication, authorization, and delivery receipt; none may be accepted from provider output."
  ]
}
