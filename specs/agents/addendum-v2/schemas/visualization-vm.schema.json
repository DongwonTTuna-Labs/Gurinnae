{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/schemas/agents/v2/visualization-vm.json",
  "title": "VisualizationVmV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "screenId",
    "visualizations",
    "visualizationSetSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "visualization-vm.v2"
    },
    "screenId": {
      "enum": ["CAS-010", "CAS-011"]
    },
    "visualizations": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/metric"
          },
          {
            "$ref": "#/$defs/timeSeries"
          },
          {
            "$ref": "#/$defs/categoryBar"
          },
          {
            "$ref": "#/$defs/comparisonTable"
          }
        ]
      }
    },
    "visualizationSetSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tableAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption", "headers", "rows", "dataSha256"],
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "headers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "dataSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visualizationId",
        "kind",
        "title",
        "questionAnswered",
        "unit",
        "asOf",
        "uncertaintyNote",
        "sourceDigest",
        "dataSha256",
        "value",
        "formattedValue",
        "comparison",
        "narrativeAlternative",
        "tableAlternative"
      ],
      "properties": {
        "visualizationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "METRIC"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "questionAnswered": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "uncertaintyNote": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "sourceDigest": {
          "$ref": "#/$defs/sha256"
        },
        "dataSha256": {
          "$ref": "#/$defs/sha256"
        },
        "value": {
          "type": "integer"
        },
        "formattedValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "comparison": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value", "direction"],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "value": {
                  "type": "integer"
                },
                "direction": {
                  "enum": ["HIGHER", "LOWER", "EQUAL", "NOT_COMPARABLE"]
                }
              }
            }
          ]
        },
        "narrativeAlternative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "tableAlternative": {
          "$ref": "#/$defs/tableAlternative"
        }
      }
    },
    "timeSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visualizationId",
        "kind",
        "title",
        "questionAnswered",
        "unit",
        "asOf",
        "uncertaintyNote",
        "sourceDigest",
        "dataSha256",
        "series",
        "narrativeAlternative",
        "tableAlternative"
      ],
      "properties": {
        "visualizationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "TIME_SERIES"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "questionAnswered": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "uncertaintyNote": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "sourceDigest": {
          "$ref": "#/$defs/sha256"
        },
        "dataSha256": {
          "$ref": "#/$defs/sha256"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seriesId", "label", "points"],
            "properties": {
              "seriesId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "points": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["at", "value", "state"],
                  "properties": {
                    "at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "value": {
                      "type": ["integer", "null"]
                    },
                    "state": {
                      "enum": ["OBSERVED", "MISSING", "ESTIMATED"]
                    }
                  }
                }
              }
            }
          }
        },
        "narrativeAlternative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "tableAlternative": {
          "$ref": "#/$defs/tableAlternative"
        }
      }
    },
    "categoryBar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visualizationId",
        "kind",
        "title",
        "questionAnswered",
        "unit",
        "asOf",
        "uncertaintyNote",
        "sourceDigest",
        "dataSha256",
        "bars",
        "narrativeAlternative",
        "tableAlternative"
      ],
      "properties": {
        "visualizationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "CATEGORY_BAR"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "questionAnswered": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "uncertaintyNote": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "sourceDigest": {
          "$ref": "#/$defs/sha256"
        },
        "dataSha256": {
          "$ref": "#/$defs/sha256"
        },
        "bars": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["categoryId", "label", "value", "state"],
            "properties": {
              "categoryId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "value": {
                "type": ["integer", "null"]
              },
              "state": {
                "enum": ["OBSERVED", "MISSING", "NOT_COMPARABLE"]
              }
            }
          }
        },
        "narrativeAlternative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "tableAlternative": {
          "$ref": "#/$defs/tableAlternative"
        }
      }
    },
    "comparisonTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visualizationId",
        "kind",
        "title",
        "questionAnswered",
        "unit",
        "asOf",
        "uncertaintyNote",
        "sourceDigest",
        "dataSha256",
        "columns",
        "rows",
        "narrativeAlternative",
        "tableAlternative"
      ],
      "properties": {
        "visualizationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "COMPARISON_TABLE"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "questionAnswered": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "uncertaintyNote": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "sourceDigest": {
          "$ref": "#/$defs/sha256"
        },
        "dataSha256": {
          "$ref": "#/$defs/sha256"
        },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["columnId", "label", "valueKind"],
            "properties": {
              "columnId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "valueKind": {
                "enum": ["TEXT", "INTEGER", "DATETIME", "STATUS"]
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rowId", "label", "cells", "sourceUseIds"],
            "properties": {
              "rowId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "cells": {
                "type": "array",
                "minItems": 2,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["columnId", "displayValue", "state"],
                  "properties": {
                    "columnId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "displayValue": {
                      "type": ["string", "null"],
                      "maxLength": 1000
                    },
                    "state": {
                      "enum": ["PRESENT", "MISSING", "NOT_COMPARABLE"]
                    }
                  }
                }
              },
              "sourceUseIds": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        "narrativeAlternative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "tableAlternative": {
          "$ref": "#/$defs/tableAlternative"
        }
      }
    }
  },
  "x-gurinnae-invariants": [
    "Every visualization has one closed kind, a meaningful unit/as-of/uncertainty/source digest, and integer or decimal-string values without floating-point receipt arithmetic.",
    "dataSha256 binds the canonical source rows; narrativeAlternative and tableAlternative are set-equal to the visual marks and preserve labels, units, uncertainty, ordering, and source-use links.",
    "visualizationSetSha256 binds the ordered unique visualization IDs and data digests; CAS-010/CAS-011 may not render a chart whose accessible table digest differs."
  ]
}
