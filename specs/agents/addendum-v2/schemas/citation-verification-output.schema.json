{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/schemas/agents/v2/citation-verification-output.json",
  "title": "CitationVerificationOutputV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outcome",
    "summary",
    "investigationsPerformed",
    "citations",
    "unknowns",
    "nextActions",
    "abstentionReasons",
    "claimResults"
  ],
  "properties": {
    "schemaVersion": {"const": "citation-verification-output.v2"},
    "outcome": {"enum": ["COMPLETED", "ABSTAINED"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 6000},
    "investigationsPerformed": {
      "type": "array",
      "minItems": 0,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/investigation"}
    },
    "citations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/citation"}
    },
    "unknowns": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyText"}
    },
    "nextActions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nextAction"}
    },
    "abstentionReasons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/abstentionReason"}
    },
    "claimResults": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/claimResult"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "COMPLETED"}}, "required": ["outcome"]},
      "then": {"properties": {"abstentionReasons": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "ABSTAINED"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "abstentionReasons": {"minItems": 1},
          "claimResults": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonemptyText": {"type": "string", "minLength": 1, "maxLength": 2000},
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "locatorSha256"],
      "properties": {
        "kind": {
          "enum": [
            "PAGE_BBOX",
            "XLSX_CELL",
            "CSV_ROW_COLUMN",
            "XML_XPATH",
            "DOCX_PARAGRAPH",
            "HWPX_XPATH",
            "JSON_POINTER",
            "HTML_CSS_SELECTOR",
            "API_FIELD",
            "TEXT_RANGE",
            "IMAGE_BBOX",
            "AUDIO_TIME_RANGE",
            "VIDEO_TIME_RANGE",
            "VIDEO_REGION_TIME"
          ]
        },
        "value": {"type": "string", "minLength": 1, "maxLength": 2048},
        "locatorSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceUseSha256",
        "locator",
        "selectedContentSha256",
        "supports",
        "supportsSha256"
      ],
      "properties": {
        "sourceUseSha256": {"$ref": "#/$defs/sha256"},
        "locator": {"$ref": "#/$defs/locator"},
        "selectedContentSha256": {"$ref": "#/$defs/sha256"},
        "supports": {"type": "string", "minLength": 1, "maxLength": 2000},
        "supportsSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolId", "objective", "resultSummary", "toolResultSha256"],
      "properties": {
        "toolId": {"enum": ["evidence.read", "source.locator_verify"]},
        "objective": {"type": "string", "minLength": 1, "maxLength": 1000},
        "resultSummary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "toolResultSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionType", "reason", "targetDescription", "requiresHumanDecision"],
      "properties": {
        "actionType": {"enum": ["VERIFY_EVIDENCE", "COLLECT_SOURCE", "REVISE_CLAIM", "REVIEW_CLAIM", "NO_ACTION"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "targetDescription": {"type": "string", "minLength": 1, "maxLength": 1000},
        "requiresHumanDecision": {"type": "boolean"}
      }
    },
    "abstentionReason": {
      "enum": [
        "UNTRUSTED_INSTRUCTION_DETECTED",
        "CITATION_REQUIRED",
        "BUDGET_EXHAUSTED",
        "PROVIDER_UNAVAILABLE",
        "EVIDENCE_OUTSIDE_SNAPSHOT",
        "TOOL_NOT_ALLOWED",
        "CITATION_LOCATOR_MISMATCH",
        "EVIDENCE_SNAPSHOT_STALE",
        "ITERATION_LIMIT_REACHED",
        "INSUFFICIENT_EVIDENCE",
        "TOOL_RESULT_INCOMPLETE"
      ]
    },
    "citationIndexes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 999}
    },
    "unsupportedFragments": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyText"}
    },
    "claimResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimIndex", "status", "verifiedCitationIndexes", "unsupportedFragments"],
      "properties": {
        "claimIndex": {"type": "integer", "minimum": 0, "maximum": 999},
        "status": {"enum": ["VERIFIED", "UNSUPPORTED", "PARTIAL"]},
        "verifiedCitationIndexes": {"$ref": "#/$defs/citationIndexes"},
        "unsupportedFragments": {"$ref": "#/$defs/unsupportedFragments"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "VERIFIED"}}, "required": ["status"]},
          "then": {
            "properties": {
              "verifiedCitationIndexes": {"minItems": 1},
              "unsupportedFragments": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "UNSUPPORTED"}}, "required": ["status"]},
          "then": {
            "properties": {
              "verifiedCitationIndexes": {"maxItems": 0},
              "unsupportedFragments": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "PARTIAL"}}, "required": ["status"]},
          "then": {
            "properties": {
              "verifiedCitationIndexes": {"minItems": 1},
              "unsupportedFragments": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
