{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/schemas/agents/v2/skeptic-output.json",
  "title": "SkepticOutputV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outcome",
    "summary",
    "investigationsPerformed",
    "citations",
    "unknowns",
    "nextActions",
    "abstentionReasons",
    "challenges"
  ],
  "properties": {
    "schemaVersion": {
      "const": "skeptic-output.v2"
    },
    "outcome": {
      "enum": [
        "COMPLETED",
        "ABSTAINED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "investigationsPerformed": {
      "type": "array",
      "minItems": 0,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/investigation"
      }
    },
    "citations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nextAction"
      }
    },
    "abstentionReasons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/abstentionReason"
      }
    },
    "challenges": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/challengeDraft"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "COMPLETED"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "abstentionReasons": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ABSTAINED"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "abstentionReasons": {
            "minItems": 1
          },
          "challenges": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "locatorSha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "PAGE_BBOX",
            "XLSX_CELL",
            "CSV_ROW_COLUMN",
            "XML_XPATH",
            "DOCX_PARAGRAPH",
            "HWPX_XPATH",
            "JSON_POINTER",
            "HTML_CSS_SELECTOR",
            "API_FIELD",
            "TEXT_RANGE",
            "IMAGE_BBOX",
            "AUDIO_TIME_RANGE",
            "VIDEO_TIME_RANGE",
            "VIDEO_REGION_TIME"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "locatorSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceUseSha256",
        "locator",
        "selectedContentSha256",
        "supports",
        "supportsSha256"
      ],
      "properties": {
        "sourceUseSha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "selectedContentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "supports": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "supportsSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolId",
        "objective",
        "resultSummary",
        "toolResultSha256"
      ],
      "properties": {
        "toolId": {
          "enum": [
            "evidence.search",
            "evidence.read",
            "rule.reproduce"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "resultSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "toolResultSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "unknown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionType",
        "reason",
        "targetDescription",
        "requiresHumanDecision"
      ],
      "properties": {
        "actionType": {
          "enum": [
            "COLLECT_SOURCE",
            "VERIFY_EVIDENCE",
            "REQUEST_RESPONSE",
            "REVIEW_HYPOTHESIS",
            "REVIEW_CLAIM",
            "REVIEW_COMPARABLE",
            "PROMOTE_RESEARCH_ARTIFACT",
            "NO_ACTION"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "targetDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "requiresHumanDecision": {
          "type": "boolean"
        }
      }
    },
    "abstentionReason": {
      "enum": [
        "UNTRUSTED_INSTRUCTION_DETECTED",
        "CITATION_REQUIRED",
        "BUDGET_EXHAUSTED",
        "PROVIDER_UNAVAILABLE",
        "EVIDENCE_OUTSIDE_SNAPSHOT",
        "TOOL_NOT_ALLOWED",
        "CITATION_LOCATOR_MISMATCH",
        "EVIDENCE_SNAPSHOT_STALE",
        "ITERATION_LIMIT_REACHED",
        "INSUFFICIENT_EVIDENCE",
        "TOOL_RESULT_INCOMPLETE"
      ]
    },
    "citationIndexes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999
      }
    },
    "challengeDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "claimOrHypothesis",
        "challenge",
        "challengeType",
        "citationIndexes",
        "severity"
      ],
      "properties": {
        "kind": {
          "const": "CHALLENGE"
        },
        "claimOrHypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "challenge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "challengeType": {
          "enum": [
            "FALSE_POSITIVE_RISK",
            "DATA_ERROR",
            "ALTERNATIVE_EXPLANATION",
            "PUBLICATION_BLOCKER"
          ]
        },
        "citationIndexes": {
          "$ref": "#/$defs/citationIndexes"
        },
        "severity": {
          "enum": [
            "INFO",
            "MATERIAL",
            "BLOCKING"
          ]
        }
      }
    }
  },
  "x-gurinnae-invariants": [
    "Every citation is bound to an existing run source use by sourceUseSha256; the server re-extracts locator bytes and verifies selectedContentSha256 plus supportsSha256 before accepting a challenge.",
    "citationIndexes are zero-based indexes into this output's citations array, contain no server identifier, and must resolve in range without duplicates.",
    "Challenges are read-only review drafts and cannot reject, approve, publish, change case state, or decide that corruption or crime occurred.",
    "The server derives every runtime identifier, status, approval, authentication, authorization, and delivery receipt; none may be accepted from provider output."
  ]
}
