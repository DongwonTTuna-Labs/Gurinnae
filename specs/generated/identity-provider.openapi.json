          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "retryAfterSeconds": {
            "type": "integer"
          }
        }
      },
      "logoutInternalSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "csrfToken": {
            "type": "string"
          },
          "returnTo": {
            "type": "string",
            "format": "uri-reference"
          }
        },
        "required": [
          "csrfToken"
        ]
      },
      "startStepUpAuthenticationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "returnTo": {
            "type": "string",
            "format": "uri-reference"
          },
          "actionDescriptor": {
            "$ref": "#/components/schemas/HighImpactActionDescriptor"
          },
          "csrfToken": {
            "type": "string",
            "minLength": 43,
            "maxLength": 64
          }
        },
        "required": [
          "returnTo",
          "actionDescriptor",
          "csrfToken"
        ]
      },
      "CoverageRecordCounts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceDocuments": {
            "type": "integer",
            "minimum": 0
          },
          "contracts": {
            "type": "integer",
            "minimum": 0
          },
          "contractLineItems": {
            "type": "integer",
            "minimum": 0
          },
          "agencies": {
            "type": "integer",
            "minimum": 0
          },
          "suppliers": {
            "type": "integer",
            "minimum": 0
          },
          "publicCases": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "sourceDocuments",
          "contracts",
          "contractLineItems",
          "agencies",
          "suppliers",
          "publicCases"
        ]
      },
      "HighImpactActionDescriptor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]{1,127}$"
          },
          "aggregateType": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "aggregateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expectedVersion": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "businessPayloadSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "operationId",
          "aggregateType",
          "aggregateId",
          "expectedVersion",
          "businessPayloadSha256"
        ]
      }
    }
  }
}
