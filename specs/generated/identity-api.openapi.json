            "format": "uuid"
          },
          "expectedAssertionRevision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "expectedAssertionDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expectedEvidenceLocatorSetDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "VERIFY",
              "REJECT",
              "MARK_CONFLICT",
              "SUPERSEDE"
            ]
          },
          "counterAssertionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "EVIDENCE_CONFIRMED",
              "EVIDENCE_INSUFFICIENT",
              "EVIDENCE_CONTRADICTED",
              "SOURCE_CORRECTED",
              "ASSERTION_SUPERSEDED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": [
          "assertionId",
          "expectedAssertionRevision",
          "expectedAssertionDigest",
          "expectedEvidenceLocatorSetDigest",
          "decision",
          "counterAssertionIds",
          "reasonCode",
          "reason"
        ]
      }
    }
  }
