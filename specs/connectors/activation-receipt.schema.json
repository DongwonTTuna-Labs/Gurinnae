{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurine.invalid/connectors/activation-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connector_id",
    "checked_at",
    "status",
    "operation_receipts",
    "terms_review_id",
    "config_digest"
  ],
  "properties": {
    "connector_id": {
      "type": "string"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["READY", "DISABLED", "FAILED"]
    },
    "operation_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "http_status",
          "schema_fingerprint",
          "sample_sha256",
          "identity_fields_resolved",
          "required_mappings_resolved"
        ],
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "http_status": {
            "type": "integer"
          },
          "schema_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sample_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "identity_fields_resolved": {
            "type": "boolean"
          },
          "required_mappings_resolved": {
            "type": "boolean"
          }
        }
      }
    },
    "terms_review_id": {
      "type": "string"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "failure_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
