{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Submission BFF Session Cookie Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "typ",
    "sessionKind",
    "opaqueSessionToken",
    "csrfToken",
    "issuedAt",
    "absoluteExpiresAt",
    "csrfRotatedAt"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "typ": {
      "const": "submission-session"
    },
    "sessionKind": {
      "enum": [
        "RESPONSE_PENDING",
        "RESPONSE_ACTIVE",
        "CORRECTION_DRAFT",
        "SUBSCRIPTION_PENDING",
        "SUBSCRIPTION_MANAGEMENT",
        "RESPONSE_RECEIPT",
        "CORRECTION_RECEIPT"
      ]
    },
    "opaqueSessionToken": {
      "type": "string",
      "minLength": 43,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "csrfToken": {
      "type": "string",
      "minLength": 43,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0
    },
    "absoluteExpiresAt": {
      "type": "integer",
      "minimum": 0
    },
    "csrfRotatedAt": {
      "type": "integer",
      "minimum": 0
    }
  }
}
