{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Step-up Transaction Cookie Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "typ",
    "transactionCookieValue",
    "idempotencyKey",
    "actionDigest",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "typ": {
      "const": "step-up-transaction"
    },
    "transactionCookieValue": {
      "type": "string",
      "minLength": 43,
      "maxLength": 256
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 200
    },
    "actionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issuedAt": {
      "type": "integer"
    },
    "expiresAt": {
      "type": "integer"
    }
  }
}
