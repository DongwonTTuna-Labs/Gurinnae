{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurine.invalid/events/case.state_transitioned.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_id",
    "caseId",
    "occurred_at",
    "operation_id",
    "request_id",
    "transition_id",
    "from_state",
    "to_state",
    "reason",
    "case_version"
  ],
  "properties": {
    "actor_id": {
      "type": "string"
    },
    "caseId": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "operation_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "transition_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,99}$"
    },
    "from_state": {
      "type": "string",
      "enum": [
        "SIGNAL_DETECTED",
        "TRIAGE",
        "INVESTIGATING",
        "AWAITING_RESPONSE",
        "EDITORIAL_REVIEW",
        "LEGAL_REVIEW",
        "READY_TO_PUBLISH",
        "CLOSED"
      ]
    },
    "to_state": {
      "type": "string",
      "enum": [
        "SIGNAL_DETECTED",
        "TRIAGE",
        "INVESTIGATING",
        "AWAITING_RESPONSE",
        "EDITORIAL_REVIEW",
        "LEGAL_REVIEW",
        "READY_TO_PUBLISH",
        "CLOSED"
      ]
    },
    "resolution_code": {
      "type": ["string", "null"],
      "enum": [
        "NONE",
        "DATA_ERROR",
        "DUPLICATE",
        "EXPLAINED",
        "INSUFFICIENT_EVIDENCE",
        "REFERRED_CONFIDENTIAL",
        "ARCHIVED",
        null
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "case_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
