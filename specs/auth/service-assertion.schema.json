{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurine.invalid/schemas/auth/service-assertion-v1.json",
  "title": "Gurine Service Assertion Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "typ",
    "iss",
    "aud",
    "jti",
    "iat",
    "exp",
    "method",
    "path",
    "querySha256",
    "bodySha256",
    "contentType"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "typ": {
      "const": "service"
    },
    "iss": {
      "const": "review-console"
    },
    "aud": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "jti": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 0
    },
    "method": {
      "type": "string",
      "enum": ["POST"]
    },
    "nextSubmissionSessionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^/internal/v1/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$"
    },
    "querySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bodySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contentType": {
      "type": "string",
      "enum": ["", "application/json"]
    }
  }
}
