{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurine.invalid/schemas/auth/actor-assertion-v1.json",
  "title": "Gurine Actor Assertion Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "typ",
    "iss",
    "aud",
    "jti",
    "sub",
    "sid",
    "iat",
    "exp",
    "authTime",
    "assuranceLevel",
    "stepUpAt",
    "rolesVersion",
    "capabilities",
    "capabilityHash",
    "method",
    "path",
    "querySha256",
    "bodySha256",
    "contentType",
    "actionDigest",
    "operationId",
    "requiredCapability",
    "idempotencyKeySha256",
    "stepUpAuthorizationId"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "typ": {
      "const": "actor"
    },
    "iss": {
      "const": "identity-api"
    },
    "aud": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "jti": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sub": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 0
    },
    "authTime": {
      "type": "integer",
      "minimum": 0
    },
    "stepUpAt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "rolesVersion": {
      "type": "integer",
      "minimum": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
      }
    },
    "capabilityHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "method": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
    },
    "path": {
      "type": "string",
      "pattern": "^/v1/internal/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$"
    },
    "querySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bodySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contentType": {
      "type": "string",
      "enum": ["", "application/json"]
    },
    "actionDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]{1,127}$"
    },
    "requiredCapability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "idempotencyKeySha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stepUpAuthorizationId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "assuranceLevel": {
      "type": "string",
      "enum": ["ACTIVE_SESSION", "RECENT_SESSION", "STEP_UP"]
    }
  }
}
