{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/specs/acceptance/execution-receipt-v3.schema.json",
  "title": "Gurinnae exact acceptance scenario execution receipt v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "receipt_id",
    "run_id",
    "attempt",
    "status",
    "origin",
    "scenario_id",
    "feature_file",
    "scenario_title",
    "bindings",
    "invocation",
    "runtime_profile_id",
    "runtime_profile_sha256",
    "layer_receipts",
    "started_at",
    "duration_ms",
    "exit_code",
    "counts",
    "observations",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "receipt_kind": { "const": "ACCEPTANCE_SCENARIO_EXECUTION" },
    "receipt_id": {
      "type": "string",
      "pattern": "^ACR-[A-Za-z0-9._-]+-AC-[A-Z0-9_-]+-[0-9]{3}$"
    },
    "run_id": { "$ref": "#/$defs/run_id" },
    "attempt": { "const": 1 },
    "status": { "const": "PASSED" },
    "origin": { "enum": ["BASE_V13", "SUPPLEMENTAL_V1"] },
    "scenario_id": {
      "type": "string",
      "pattern": "^AC-[A-Z0-9_]+(?:-[A-Z0-9_]+)*-[0-9]{3}$"
    },
    "feature_file": { "$ref": "#/$defs/repository_path" },
    "scenario_title": { "type": "string", "minLength": 1 },
    "bindings": { "$ref": "#/$defs/bindings" },
    "invocation": { "$ref": "#/$defs/invocation" },
    "runtime_profile_id": { "type": "string", "pattern": "^[A-Z0-9_]+_V1$" },
    "runtime_profile_sha256": { "$ref": "#/$defs/sha256" },
    "layer_receipts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "runtime-layer-receipt-v1.schema.json"
      }
    },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "exit_code": { "const": 0 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered",
        "started",
        "terminal",
        "passed",
        "failed",
        "skipped",
        "retried",
        "assertions"
      ],
      "properties": {
        "discovered": { "const": 1 },
        "started": { "const": 1 },
        "terminal": { "const": 1 },
        "passed": { "const": 1 },
        "failed": { "const": 0 },
        "skipped": { "const": 0 },
        "retried": { "const": 0 },
        "assertions": { "type": "integer", "minimum": 1 }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clause_contracts",
        "example_contracts",
        "instance_contracts",
        "oracle_contracts",
        "observation_contracts",
        "assertion_event_artifact"
      ],
      "properties": {
        "clause_contracts": { "$ref": "#/$defs/digest_pairs" },
        "example_contracts": { "$ref": "#/$defs/digest_pairs" },
        "instance_contracts": { "$ref": "#/$defs/digest_pairs" },
        "oracle_contracts": { "$ref": "#/$defs/digest_pairs_nonempty" },
        "observation_contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/observation_contract" }
        },
        "assertion_event_artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "media_type"],
      "properties": {
        "path": { "$ref": "#/$defs/repository_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        }
      }
    },
    "digest_pair": {
      "type": "array",
      "prefixItems": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/sha256" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "digest_pairs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest_pair" }
    },
    "digest_pairs_nonempty": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest_pair" }
    },
    "observation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "instance_sha256",
        "clause_id",
        "clause_sha256",
        "example_id",
        "example_sha256",
        "phase",
        "oracle_contract"
      ],
      "properties": {
        "instance_id": { "type": "string", "minLength": 1 },
        "instance_sha256": { "$ref": "#/$defs/sha256" },
        "clause_id": { "type": "string", "minLength": 1 },
        "clause_sha256": { "$ref": "#/$defs/sha256" },
        "example_id": { "type": "string", "minLength": 1 },
        "example_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "phase": { "enum": ["GIVEN", "WHEN", "THEN"] },
        "oracle_contract": {
          "oneOf": [{ "$ref": "#/$defs/digest_pair" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "phase": { "const": "THEN" } },
            "required": ["phase"]
          },
          "then": {
            "properties": {
              "oracle_contract": { "$ref": "#/$defs/digest_pair" }
            }
          },
          "else": {
            "properties": {
              "oracle_contract": { "type": "null" }
            }
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_zip_sha256",
        "design_bundle_sha256",
        "member_manifest_sha256",
        "effective_registry_sha256",
        "base_mapping_sha256",
        "supplemental_mapping_sha256",
        "feature_sha256",
        "scenario_contract_sha256",
        "source_commit",
        "source_tree_sha256",
        "test_source_sha256",
        "selector_sha256",
        "archive_sha256",
        "extraction_receipt_sha256"
      ],
      "properties": {
        "authority_zip_sha256": { "$ref": "#/$defs/sha256" },
        "design_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "member_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "effective_registry_sha256": { "$ref": "#/$defs/sha256" },
        "base_mapping_sha256": { "$ref": "#/$defs/sha256" },
        "supplemental_mapping_sha256": { "$ref": "#/$defs/sha256" },
        "feature_sha256": { "$ref": "#/$defs/sha256" },
        "scenario_contract_sha256": { "$ref": "#/$defs/sha256" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_tree_sha256": { "$ref": "#/$defs/sha256" },
        "test_source_sha256": { "$ref": "#/$defs/sha256" },
        "selector_sha256": { "$ref": "#/$defs/sha256" },
        "archive_sha256": { "$ref": "#/$defs/sha256" },
        "extraction_receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_kind",
        "implementation_test_path",
        "implementation_test_id",
        "discovery_argv",
        "run_argv",
        "run_argv_sha256"
      ],
      "properties": {
        "runner_kind": { "enum": ["RUST_NEXTEST", "PLAYWRIGHT"] },
        "implementation_test_path": { "$ref": "#/$defs/repository_path" },
        "implementation_test_id": { "type": "string", "minLength": 1 },
        "discovery_argv": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "run_argv": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "prerequisite_argv": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "run_argv_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
