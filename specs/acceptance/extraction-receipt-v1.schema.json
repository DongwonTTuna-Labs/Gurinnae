{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurinnae.invalid/specs/acceptance/extraction-receipt-v1.schema.json",
  "title": "Gurinnae clean source archive extraction receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "status",
    "verified_at",
    "archive_sha256",
    "source_tree_sha256",
    "design_bundle_sha256",
    "member_manifest_sha256",
    "manifest_sha256",
    "archive_member_count",
    "extracted_member_count",
    "residue_paths",
    "verification_argv",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_kind": { "const": "CLEAN_SOURCE_ARCHIVE_EXTRACTION" },
    "status": { "const": "PASSED" },
    "verified_at": { "type": "string", "format": "date-time" },
    "archive_sha256": { "$ref": "#/$defs/sha256" },
    "source_tree_sha256": { "$ref": "#/$defs/sha256" },
    "design_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "member_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "archive_member_count": { "type": "integer", "minimum": 1 },
    "extracted_member_count": { "type": "integer", "minimum": 1 },
    "residue_paths": { "type": "array", "maxItems": 0 },
    "verification_argv": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "media_type"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        }
      }
    }
  }
}
