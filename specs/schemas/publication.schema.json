{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gurine.invalid/publication.schema.json",
  "title": "PublicationRevision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication_id",
    "revision_id",
    "revision_number",
    "case_id",
    "slug",
    "display_status",
    "non_conclusion",
    "content_hash",
    "title",
    "summary",
    "sections",
    "claims",
    "evidence",
    "subjects",
    "methodology",
    "responses",
    "corrections",
    "source_freshness",
    "published_at",
    "review_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "publication_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision_number": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_revision_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "case_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "display_status": {
      "enum": [
        "PUBLISHED_ANOMALY",
        "PUBLISHED_EXPLAINED",
        "OFFICIALLY_CONFIRMED",
        "CORRECTED",
        "RETRACTED",
        "TEMPORARILY_RESTRICTED"
      ]
    },
    "non_conclusion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "content_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "heading", "blocks"],
        "properties": {
          "section_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "heading": {
            "type": "string",
            "maxLength": 160
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": [
                    "PARAGRAPH",
                    "METRIC",
                    "TABLE",
                    "LIMITATION",
                    "RESPONSE",
                    "CORRECTION_NOTICE",
                    "TIMELINE"
                  ]
                },
                "text": {
                  "type": ["string", "null"],
                  "maxLength": 10000
                },
                "data": {
                  "type": ["object", "array", "null"]
                }
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_type", "text_ko", "evidence_refs"],
        "properties": {
          "claim_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "claim_type": {
            "enum": [
              "FACT",
              "CALCULATION",
              "INFERENCE",
              "LIMITATION",
              "OFFICIAL_OUTCOME"
            ]
          },
          "text_ko": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/evidence_ref"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "display_name"],
        "properties": {
          "type": {
            "enum": ["AGENCY", "SUPPLIER", "CONTRACT"]
          },
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "public_url": {
            "type": ["string", "null"],
            "maxLength": 300
          }
        }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_key", "rule_version", "calculation", "limitations"],
      "properties": {
        "rule_key": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "rule_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "calculation": {
          "type": "object",
          "additionalProperties": true
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "reproducibility_bundle_url": {
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["party", "status", "display_text"],
        "properties": {
          "party": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "enum": [
              "RECEIVED",
              "NO_RESPONSE_BY_DEADLINE",
              "DECLINED",
              "NOT_REQUIRED"
            ]
          },
          "display_text": {
            "type": "string",
            "maxLength": 10000
          },
          "received_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "correction_id",
          "severity",
          "reason_code",
          "published_at",
          "summary"
        ],
        "properties": {
          "correction_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "severity": {
            "enum": ["MINOR", "MATERIAL", "CRITICAL"]
          },
          "reason_code": {
            "type": "string",
            "maxLength": 100
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "source_freshness": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_published_at",
          "retrieved_at",
          "content_sha256"
        ],
        "properties": {
          "source_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "source_published_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "published_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "official_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institution",
        "document_type",
        "document_date",
        "confirmed_scope",
        "source_locator",
        "source_digest"
      ],
      "properties": {
        "institution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "document_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "document_date": {
          "type": "string",
          "format": "date"
        },
        "confirmed_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "correction_notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied_at", "reason", "impact_summary", "revision"],
      "properties": {
        "applied_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "impact_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "correction_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_reason", "limitations"],
      "properties": {
        "effective_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "review_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editor_approval_count",
        "legal_reviewed",
        "legal_review_receipt_sha256",
        "policy_version"
      ],
      "properties": {
        "editor_approval_count": {
          "type": "integer",
          "minimum": 1
        },
        "legal_reviewed": {
          "type": "boolean"
        },
        "legal_review_receipt_sha256": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "display_status": { "const": "PUBLISHED_ANOMALY" }
        },
        "required": ["display_status"]
      },
      "then": {
        "properties": {
          "non_conclusion": {
            "const": "공개자료 비교에서 설명이 필요한 차이가 확인됐습니다. 현재 자료만으로 위법성이나 부패 여부를 판단할 수 없습니다."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "display_status": { "const": "PUBLISHED_EXPLAINED" }
        },
        "required": ["display_status"]
      },
      "then": {
        "properties": {
          "non_conclusion": {
            "const": "처음 탐지된 차이는 추가 자료에서 확인된 구성·서비스·조건의 차이로 설명됩니다. 탐지와 검증 과정을 함께 공개합니다."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "display_status": { "const": "RETRACTED" }
        },
        "required": ["display_status"]
      },
      "then": {
        "properties": {
          "non_conclusion": {
            "const": "핵심 근거의 오류로 이 게시물을 철회했습니다. 원래 주장은 더 이상 유효하지 않습니다. 오류 원인과 후속 조치를 공개합니다."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "display_status": { "const": "TEMPORARILY_RESTRICTED" }
        },
        "required": ["display_status"]
      },
      "then": {
        "properties": {
          "non_conclusion": {
            "const": "법적 사유, 권리 보호 또는 안전을 위해 공개를 일시 제한했습니다. 이 제한은 위법성이나 부패 여부에 대한 판단이 아닙니다."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "display_status": {
            "const": "OFFICIALLY_CONFIRMED"
          }
        },
        "required": ["display_status"]
      },
      "then": {
        "required": ["official_confirmation"]
      },
      "else": {
        "not": {
          "required": ["official_confirmation"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "display_status": {
            "const": "CORRECTED"
          }
        },
        "required": ["display_status"]
      },
      "then": {
        "required": ["correction_notice", "correction_details"]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["correction_notice"] },
            { "required": ["correction_details"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_summary": {
            "properties": {
              "legal_reviewed": {
                "const": true
              }
            },
            "required": ["legal_reviewed"]
          }
        },
        "required": ["review_summary"]
      },
      "then": {
        "properties": {
          "review_summary": {
            "properties": {
              "legal_review_receipt_sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "review_summary": {
            "properties": {
              "legal_review_receipt_sha256": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
