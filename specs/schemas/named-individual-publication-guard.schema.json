{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gurine.invalid/named-individual-publication-guard.schema.json",
  "title": "NamedIndividualPublicationGuardEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publicPayload",
    "assessment",
    "overrideReceipt",
    "snapshotAuthorId",
    "editorialReviewDecision",
    "gateState",
    "legalReviewRequired",
    "legalReviewed"
  ],
  "properties": {
    "publicPayload": {
      "$ref": "#/$defs/publicPayload"
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rulesetVersion",
        "rulesetSha256",
        "publicTextSha256",
        "findings"
      ],
      "properties": {
        "rulesetVersion": {
          "const": "ko-named-individual-v1"
        },
        "rulesetSha256": {
          "const": "bc7b9b83c7402bfdd093cbebc6374bb5fe1a8862caeace05536016dab3ce71cf"
        },
        "publicTextSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "findings": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "startUtf16",
              "endUtf16",
              "basis",
              "rulesetVersion"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/",
                "maxLength": 2048
              },
              "startUtf16": {
                "type": "integer",
                "minimum": 0
              },
              "endUtf16": {
                "type": "integer",
                "minimum": 1
              },
              "basis": {
                "enum": [
                  "REGISTERED_PERSON_EXACT",
                  "TITLE_ADJACENT_KOREAN_NAME"
                ]
              },
              "rulesetVersion": {
                "const": "ko-named-individual-v1"
              }
            }
          }
        }
      }
    },
    "overrideReceipt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receiptVersion",
            "publicTextSha256",
            "rulesetVersion",
            "reasonCode",
            "officialSourceLocator",
            "officialSourceSha256",
            "editorialReviewDecisionId",
            "legalReviewerId",
            "receiptSha256"
          ],
          "properties": {
            "receiptVersion": {
              "const": "named-individual-legal-override-v1"
            },
            "publicTextSha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "rulesetVersion": {
              "const": "ko-named-individual-v1"
            },
            "reasonCode": {
              "enum": ["PUBLIC_FIGURE", "OFFICIAL_DISPOSITION_QUOTE"]
            },
            "officialSourceLocator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "officialSourceSha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "editorialReviewDecisionId": {
              "type": "string",
              "format": "uuid"
            },
            "legalReviewerId": {
              "type": "string",
              "format": "uuid"
            },
            "receiptSha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshotAuthorId": {
      "type": "string",
      "format": "uuid"
    },
    "currentLegalActorId": {
      "type": "string",
      "format": "uuid"
    },
    "editorialReviewDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision", "reviewerId"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "decision": {
          "const": "APPROVE"
        },
        "reviewerId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "gateState": {
      "enum": ["PASS", "BLOCKED"]
    },
    "legalReviewRequired": {
      "type": "boolean"
    },
    "legalReviewed": {
      "type": "boolean"
    }
  },
  "$defs": {
    "publicPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationState",
        "slug",
        "title",
        "summary",
        "nonConclusion",
        "claims",
        "evidence",
        "responses"
      ],
      "properties": {
        "publicationState": {
          "const": "PUBLISHED_ANOMALY"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "nonConclusion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/publicPayloadClaim"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/publicPayloadEvidence"
          }
        },
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicPayloadResponse"
          }
        }
      }
    },
    "publicPayloadClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "limitations"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "publicPayloadEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "sourceUrl"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 2048
        },
        "publicExcerpt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publicPayloadResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partyName"],
      "properties": {
        "partyName": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "assessment": {
          "properties": {
            "findings": {
              "maxItems": 0
            }
          }
        },
        "overrideReceipt": {
          "type": "null"
        },
        "gateState": {
          "const": "PASS"
        },
        "legalReviewRequired": {
          "const": false
        },
        "legalReviewed": {
          "const": false
        }
      }
    },
    {
      "properties": {
        "assessment": {
          "properties": {
            "findings": {
              "minItems": 1
            }
          }
        },
        "overrideReceipt": {
          "type": "null"
        },
        "gateState": {
          "const": "BLOCKED"
        },
        "legalReviewRequired": {
          "const": true
        },
        "legalReviewed": {
          "const": false
        }
      }
    },
    {
      "required": ["currentLegalActorId"],
      "properties": {
        "assessment": {
          "properties": {
            "findings": {
              "minItems": 1
            }
          }
        },
        "overrideReceipt": {
          "type": "object"
        },
        "gateState": {
          "const": "PASS"
        },
        "legalReviewRequired": {
          "const": true
        },
        "legalReviewed": {
          "const": true
        }
      }
    }
  ]
}
