{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gurine.invalid/anomaly-signal.schema.json",
  "title": "AnomalySignal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signal_id",
    "rule",
    "subject",
    "signal_type",
    "metrics",
    "input_ids",
    "input_hash",
    "data_quality",
    "blocking_conditions",
    "publishability",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "signal_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_key", "version", "rule_run_id"],
      "properties": {
        "rule_key": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "rule_run_id": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": [
            "CONTRACT",
            "LINE_ITEM",
            "AGENCY",
            "SUPPLIER",
            "NOTICE",
            "CONTRACT_GROUP"
          ]
        },
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    },
    "signal_type": {
      "enum": [
        "PRICE_OUTLIER",
        "CONTRACT_SPLITTING_PATTERN",
        "REPEATED_SINGLE_SOURCE",
        "SUPPLIER_CONCENTRATION",
        "LOW_COMPETITION",
        "CONTRACT_AMENDMENT_ESCALATION",
        "YEAR_END_SPEND_SPIKE",
        "NEW_SUPPLIER_DEPENDENCY",
        "SHARED_IDENTIFIER_NETWORK",
        "SPECIFICATION_RESTRICTIVENESS"
      ]
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean", "null"]
      }
    },
    "input_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "input_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "cohort_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "provenance_complete", "identity_status"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "provenance_complete": {
          "type": "boolean"
        },
        "identity_status": {
          "enum": ["VERIFIED", "AMBIGUOUS", "UNKNOWN"]
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "blocking_conditions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "INSUFFICIENT_DATA",
          "UNIT_INCOMPATIBLE",
          "VAT_UNKNOWN",
          "BUNDLE_UNKNOWN",
          "SPEC_UNKNOWN",
          "IDENTITY_AMBIGUOUS",
          "SOURCE_STALE",
          "SOURCE_DUPLICATE",
          "CONTRACT_CANCELLED",
          "AMENDMENT_UNRESOLVED",
          "LEGAL_POLICY_UNKNOWN",
          "KNOWN_FRAMEWORK_AGREEMENT",
          "EMERGENCY_CONTEXT",
          "EXCLUSIVE_RIGHTS_CONTEXT",
          "OUT_OF_SCOPE_SECURITY"
        ]
      }
    },
    "publishability": {
      "enum": ["NOT_ASSESSED", "BLOCKED", "ELIGIBLE_FOR_INVESTIGATION"]
    },
    "internal_priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "enum": [
        "NEW",
        "ASSIGNED",
        "NEEDS_DATA",
        "LINKED",
        "DISMISSED",
        "DUPLICATE"
      ]
    },
    "dismissal_reason": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
