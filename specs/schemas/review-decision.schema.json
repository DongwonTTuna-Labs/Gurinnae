{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gurine.invalid/review-decision.schema.json",
  "title": "ReviewDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_decision_id",
    "case_id",
    "review_snapshot_hash",
    "reviewer",
    "reviewer_role",
    "decision",
    "policy_version",
    "created_at"
  ],
  "properties": {
    "review_decision_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "case_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "review_snapshot_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "reviewer": {
      "$ref": "common.schema.json#/$defs/actor_ref"
    },
    "reviewer_role": {
      "enum": [
        "TRIAGER",
        "INVESTIGATOR",
        "EDITOR",
        "LEGAL_REVIEWER",
        "EXECUTIVE",
        "PUBLISHER",
        "AUDITOR"
      ]
    },
    "decision": {
      "enum": ["APPROVE", "REJECT", "CHANGES_REQUIRED"]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "reason": {
      "type": ["string", "null"],
      "maxLength": 5000
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "revoked_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
